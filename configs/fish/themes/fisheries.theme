# name: 'Fisheries Innovation Scotland'
# preferred_background: 0c0c0c
# Command-line colors from the same palette as configs/starship.toml: https://www.color-hex.com/color-palette/94084
# Light blue 66b2e4, mid blue 348bc3, indigo 405592 (dim), navy 0d3c5c (backgrounds only), orange f49b45 (attention)
fish_color_normal normal
fish_color_command 66b2e4
fish_color_keyword 66b2e4
fish_color_param normal
fish_color_option 348bc3
fish_color_operator 348bc3
fish_color_redirection 348bc3
fish_color_end 348bc3
fish_color_quote f49b45
fish_color_escape f49b45
fish_color_error f49b45 --bold
fish_color_comment 405592
fish_color_autosuggestion 405592
fish_color_valid_path --underline
fish_color_cancel f49b45
fish_color_selection --background=0d3c5c
fish_color_search_match --background=0d3c5c
fish_color_history_current --bold
fish_color_cwd 66b2e4
fish_color_cwd_root f49b45
fish_color_user 348bc3
fish_color_host 348bc3
fish_color_host_remote f49b45
fish_color_status f49b45
fish_pager_color_prefix 66b2e4 --bold
fish_pager_color_completion normal
fish_pager_color_description 348bc3
fish_pager_color_progress f49b45
fish_pager_color_selected_background --background=0d3c5c
